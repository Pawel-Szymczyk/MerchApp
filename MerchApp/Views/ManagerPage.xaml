<Page
    x:Class="MerchApp.Views.ManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MerchApp.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="16" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock
                    Text="Rental Requests"
                    Style="{StaticResource TitleLargeTextBlockStyle}"/>
                <TextBlock
                    Text="Review and manage all rental requests"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCommand}">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Filter -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8">
            <RadioButton
                Content="All"
                IsChecked="True"
                Command="{x:Bind ViewModel.FilterByCommand}"
                CommandParameter="All"/>
            <RadioButton
                Content="Pending"
                Command="{x:Bind ViewModel.FilterByCommand}"
                CommandParameter="Pending"/>
            <RadioButton
                Content="Active"
                Command="{x:Bind ViewModel.FilterByCommand}"
                CommandParameter="Active"/>
            <RadioButton
                Content="Overdue"
                Command="{x:Bind ViewModel.FilterByCommand}"
                CommandParameter="Overdue"/>
            <RadioButton
                Content="Returned"
                Command="{x:Bind ViewModel.FilterByCommand}"
                CommandParameter="Returned"/>
        </StackPanel>

        <!-- Loading -->
        <ProgressRing
            Grid.Row="2"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

        <!-- Requests list -->
        <ListView
            Grid.Row="2"
            x:Name="RequestsList"
            ItemsSource="{x:Bind ViewModel.FilteredRequests, Mode=OneWay}"
            SelectionMode="Single"
            SelectionChanged="RequestsList_SelectionChanged">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:RentalRequest">
                    <Grid Padding="0,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar initials -->
                        <Border
                            Grid.Column="0"
                            Width="36" Height="36"
                            CornerRadius="18"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{x:Bind UserDisplayName}"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind UserDisplayName}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind RentalFrom}"/>
                                <Run Text="→"/>
                                <Run Text="{x:Bind RentalTo}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Status -->
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind StatusDisplayName}"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"/>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Page>