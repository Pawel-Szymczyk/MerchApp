<Page
    x:Class="MerchApp.Views.ManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MerchApp.ViewModels"
    Background="#2b2b2b">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock
                    Text="Rental Requests"
                    FontSize="21"
                    Style="{StaticResource TitleLargeTextBlockStyle}"/>
                <TextBlock
                    Text="Select requests to approve or reject"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCommand}">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Filter -->
        <Border
            Grid.Row="1"
            Padding="12,8"
            Margin="0,0,0,12"
            CornerRadius="8"
            BorderBrush="#2effffff"
            BorderThickness="1"
            Background="#2b2b2b">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <RadioButton
                    Content="All"
                    Command="{x:Bind ViewModel.FilterByCommand}"
                    CommandParameter="All"/>
                <RadioButton
                    Content="Pending"
                    IsChecked="True"
                    Command="{x:Bind ViewModel.FilterByCommand}"
                    CommandParameter="Pending"/>
                <RadioButton
                    Content="Active"
                    Command="{x:Bind ViewModel.FilterByCommand}"
                    CommandParameter="Active"/>
                <RadioButton
                    Content="Overdue"
                    Command="{x:Bind ViewModel.FilterByCommand}"
                    CommandParameter="Overdue"/>
                <RadioButton
                    Content="Returned"
                    Command="{x:Bind ViewModel.FilterByCommand}"
                    CommandParameter="Returned"/>
            </StackPanel>
        </Border>

        <!-- Select all + counter -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox
                Grid.Column="0"
                Content="Select all"
                IsChecked="{x:Bind ViewModel.AllSelected, Mode=TwoWay}"/>

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}"/>
                <Run Text="selected ("/>
                <Run Text="{x:Bind ViewModel.PendingSelectedCount, Mode=OneWay}"/>
                <Run Text="pending)"/>
            </TextBlock>
        </Grid>

        <!-- Loading + Error — hidden when not needed -->
        <Grid Grid.Row="3">
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Center"
                Margin="0,4,0,4"/>
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                Title="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>
        </Grid>

        <!-- Requests list -->
        <ListView
            Grid.Row="4"
            ItemsSource="{x:Bind ViewModel.FilteredRequests, Mode=OneWay}"
            SelectionMode="None">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SelectableRequest">
                    <Grid ColumnSpacing="0" Margin="0,4,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Checkbox poza ramką -->
                        <CheckBox
                            Grid.Column="0"
                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                            VerticalAlignment="Top"
                            Margin="0,8,0,0"
                            Tapped="Checkbox_Tapped"/>

                        <!-- Ramka z contentem -->
                        <Border
                            Grid.Column="1"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Tapped="RequestRow_Tapped">

                            <StackPanel>

                                <!-- Row header -->
                                <Grid Padding="12,12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar -->
                                    <Border
                                        Grid.Column="0"
                                        Width="36" Height="36"
                                        CornerRadius="18"
                                        Background="#2d2118"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="#d06d1f"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Request.Initials}"/>
                                    </Border>

                                    <!-- Info -->
                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{x:Bind Request.UserDisplayName}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Bind Request.RentalFromFormatted}"/>
                                            <Run Text="→"/>
                                            <Run Text="{x:Bind Request.RentalToFormatted}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Status -->
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind Request.StatusDisplayName}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{x:Bind Request.Status, Converter={StaticResource StatusToColorConverter}}"/>
                                </Grid>

                                <!-- Expanded details -->
                                <StackPanel
                                    Padding="12,0,12,12"
                                    Spacing="12"
                                    Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                                    <Border
                                        Height="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                    <!-- Items -->
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="ITEMS"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <ItemsControl ItemsSource="{x:Bind Request.Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}">
                                                        <Run Text="{Binding ItemName}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Purpose -->
                                    <Border
                                        Padding="12,8"
                                        CornerRadius="6"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        Visibility="{x:Bind Request.Purpose, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock
                                            Text="{x:Bind Request.Purpose}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextWrapping="Wrap"/>
                                    </Border>

                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Pending action bar -->
        <Border
            Grid.Row="5"
            Padding="16,12"
            Margin="0,8,0,0"
            CornerRadius="8"
            Background="#2b2b2b"
            BorderBrush="#2effffff"
            BorderThickness="1"
            Visibility="{x:Bind ViewModel.HasPendingSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
                    <TextBlock
                        Text="Reason for rejection (visible to requester)"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#d06d1f"/>
                    <Border
                        CornerRadius="6"
                        BorderBrush="#d06d1f"
                        BorderThickness="1">
                        <TextBox
                            PlaceholderText="e.g. Already reserved for another event..."
                            Text="{x:Bind ViewModel.RejectReason, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0"/>
                    </Border>
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right">
                    <Button
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Reject"
                        Command="{x:Bind ViewModel.RejectSelectedCommand}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"/>
                    <Button
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Approve"
                        Command="{x:Bind ViewModel.ApproveSelectedCommand}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Approved/Overdue action bar -->
        <Border
            Grid.Row="6"
            Padding="16,12"
            Margin="0,8,0,0"
            CornerRadius="8"
            Background="#2b2b2b"
            BorderBrush="#2effffff"
            BorderThickness="1"
            Visibility="{x:Bind ViewModel.HasApprovedSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right">
                <Button
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Mark as Returned"
                    Command="{x:Bind ViewModel.MarkAsReturnedSelectedCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Returned action bar -->
        <Border
            Grid.Row="7"
            Padding="16,12"
            Margin="0,8,0,0"
            CornerRadius="8"
            Background="#2b2b2b"
            BorderBrush="#2effffff"
            BorderThickness="1"
            Visibility="{x:Bind ViewModel.HasReturnedSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right">
                <TextBlock
                    Text="Selected records will be permanently deleted."
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#9a9a9a"/>
                <Button
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="Remove from Records"
                    Command="{x:Bind ViewModel.RemoveSelectedCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>