<Page
    x:Class="MerchApp.Views.ManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MerchApp.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="12" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock
                    Text="Rental Requests"
                    Style="{StaticResource TitleLargeTextBlockStyle}"/>
                <TextBlock
                    Text="Select requests to approve or reject"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCommand}">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Filter -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8">
            <RadioButton
                Content="All"
                Command="{x:Bind ViewModel.FilterByCommand}"
                CommandParameter="All"/>
            <RadioButton
                Content="Pending"
                IsChecked="True"
                Command="{x:Bind ViewModel.FilterByCommand}"
                CommandParameter="Pending"/>
            <RadioButton
                Content="Active"
                Command="{x:Bind ViewModel.FilterByCommand}"
                CommandParameter="Active"/>
            <RadioButton
                Content="Overdue"
                Command="{x:Bind ViewModel.FilterByCommand}"
                CommandParameter="Overdue"/>
            <RadioButton
                Content="Returned"
                Command="{x:Bind ViewModel.FilterByCommand}"
                CommandParameter="Returned"/>
        </StackPanel>

        <!-- Select all + counter -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox
                Grid.Column="0"
                Content="Select all"
                IsChecked="{x:Bind ViewModel.AllSelected, Mode=TwoWay}"/>

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}"/>
                <Run Text="selected ("/>
                <Run Text="{x:Bind ViewModel.PendingSelectedCount, Mode=OneWay}"/>
                <Run Text="pending)"/>
            </TextBlock>
        </Grid>

        <!-- Loading -->
        <ProgressRing
            Grid.Row="3"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

        <!-- Error -->
        <InfoBar
            Grid.Row="3"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Severity="Error"
            Title="Error"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>

        <!-- Requests list -->
        <ListView
            Grid.Row="3"
            ItemsSource="{x:Bind ViewModel.FilteredRequests, Mode=OneWay}"
            SelectionMode="None">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SelectableRequest">
                    <StackPanel>

                        <!-- Row -->
                        <Grid
                            Padding="8,12"
                            ColumnSpacing="12"
                            Tapped="RequestRow_Tapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Checkbox -->
                            <CheckBox
                                Grid.Column="0"
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Tapped="Checkbox_Tapped"/>

                            <!-- Avatar -->
                            <Border
                                Grid.Column="1"
                                Width="36" Height="36"
                                CornerRadius="18"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Request.Initials}"/>
                            </Border>

                            <!-- Info -->
                            <StackPanel
                                Grid.Column="2"
                                Spacing="2"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind Request.UserDisplayName}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind Request.RentalFrom}"/>
                                    <Run Text="→"/>
                                    <Run Text="{x:Bind Request.RentalTo}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Status -->
                            <TextBlock
                                Grid.Column="3"
                                Text="{x:Bind Request.StatusDisplayName}"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{x:Bind Request.Status, Converter={StaticResource StatusToColorConverter}}"/>

                        </Grid>

                        <!-- Expanded details -->
                        <!-- Expanded details -->
                        <Border
                            Padding="16"
                            Margin="0,0,0,4"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                            <StackPanel Spacing="12">

                                <!-- Items -->
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="ITEMS"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ItemsControl ItemsSource="{x:Bind Request.Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Style="{StaticResource BodyTextBlockStyle}">
                                                    <Run Text="{Binding ItemName}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Purpose -->
                                <Border
                                    Padding="12,8"
                                    CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    Visibility="{x:Bind Request.Purpose, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock
                                        Text="{x:Bind Request.Purpose}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"/>
                                </Border>

                                <!-- Dates -->
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind Request.RentalFrom}"/>
                                    <Run Text="→"/>
                                    <Run Text="{x:Bind Request.RentalTo}"/>
                                </TextBlock>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Bottom action bar -->
        <Grid
            Grid.Row="4"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.HasPendingSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                PlaceholderText="Reject reason (optional)"
                Text="{x:Bind ViewModel.RejectReason, Mode=TwoWay}"/>

            <Button
                Grid.Column="1"
                Content="Reject"
                Foreground="Red"
                Command="{x:Bind ViewModel.RejectSelectedCommand}"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"/>

            <Button
                Grid.Column="2"
                Content="Approve"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.ApproveSelectedCommand}"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"/>
        </Grid>

    </Grid>
</Page>