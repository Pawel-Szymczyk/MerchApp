<Page
    x:Class="MerchApp.Views.CartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MerchApp.Models"
    Background="#2b2b2b">

    <Grid RowSpacing="16" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <HyperlinkButton
                Content="← Back to Catalogue"
                Style="{StaticResource OrangeHyperlinkButtonStyle}"
                Click="BackToCatalogue_Click"
                Margin="0,0,0,12"/>
            <TextBlock
                Text="Your Request"
                FontSize="21"
                Style="{StaticResource TitleLargeTextBlockStyle}"/>
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <Run Text="{x:Bind ViewModel.ItemCount, Mode=OneWay}"/>
                <Run Text="items · will be sent to manager for approval"/>
            </TextBlock>
        </StackPanel>

        <!-- Items list — full width on top, max 4 visible -->
        <ScrollViewer
            Grid.Row="1"
            MaxHeight="200"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolNegationToVisibilityConverter}}">
            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.CartItems, Mode=OneWay}"
                SelectionMode="None"
                MaxHeight="200"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolNegationToVisibilityConverter}}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:CartItem">
                        <Border
                            Padding="12,8"
                            CornerRadius="8"
                            BorderBrush="#2effffff"
                            BorderThickness="1"
                            Margin="0, 4"
                            Background="#2b2b2b">
                            <Grid Padding="0,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind Item.Title}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        VerticalAlignment="Center"/>

                                <Button
                                        Grid.Column="1"
                                        Content="✕"
                                        Width="32" Height="32"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Click="RemoveItem_Click"
                                        Tag="{x:Bind Item.Id}"/>


                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel
            Grid.Row="1"
            Spacing="12"
            HorizontalAlignment="Center"
            Margin="0,48,0,0"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon
                Glyph="&#xE7BF;"
                FontSize="48"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock
                Text="Your cart is empty"
                Style="{StaticResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center"/>
            <TextBlock
                Text="Go back to the catalogue and select items"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Dates + Calendar — side by side below items -->
        <Grid
            Grid.Row="2"
            ColumnSpacing="24"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolNegationToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left — dates + purpose -->
            <StackPanel Grid.Column="0" Spacing="12">

                <!-- From date -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="From"
                        Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <Border
                        x:Name="FromDateBorder"
                        Padding="12,8"
                        CornerRadius="6"
                        BorderThickness="2"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        PointerPressed="FromDate_Click">
                        <TextBlock
                            Text="{x:Bind ViewModel.RentalFromDisplay, Mode=OneWay}"
                            Style="{StaticResource BodyTextBlockStyle}"/>
                    </Border>
                </StackPanel>

                <!-- To date -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="To"
                        Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <Border
                        x:Name="ToDateBorder"
                        Padding="12,8"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        PointerPressed="ToDate_Click">
                        <TextBlock
                            Text="{x:Bind ViewModel.RentalToDisplay, Mode=OneWay}"
                            Style="{StaticResource BodyTextBlockStyle}"/>
                    </Border>
                </StackPanel>

                <!-- Duration -->
                <Border
                    Padding="12,8"
                    CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                        <Run Text="Duration:"/>
                        <Run Text="{x:Bind ViewModel.RentalDays, Mode=OneWay}" Foreground="#d06d1f"/>
                        <Run Text="days" Foreground="#d06d1f"/>
                    </TextBlock>
                </Border>

                <!-- Purpose -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Purpose / note (optional)"
                        Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBox
                            PlaceholderText="e.g. Conference stand, awareness event..."
                            Text="{x:Bind ViewModel.Purpose, Mode=TwoWay}"
                            AcceptsReturn="True"
                            Height="80"
                            TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Error -->
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Severity="Error"
                    Title="Error"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>

                <!-- Success -->
                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsSubmitted, Mode=OneWay}"
                    Severity="Success"
                    Title="Request submitted!"
                    Message="The manager will receive an email notification and review your request."/>

            </StackPanel>

            <!-- Right — Calendar -->
            <CalendarView
                x:Name="MainCalendar"
                Grid.Column="1"
                VerticalAlignment="Top"
                SelectionMode="Multiple"
                SelectedDatesChanged="Calendar_SelectedDatesChanged"/>

        </Grid>

        <!-- Footer -->
        <Grid
            Grid.Row="3"
            ColumnSpacing="12"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolNegationToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="After submitting, the manager will receive an email notification."/>

            <Button
                Grid.Column="1"
                Style="{StaticResource SecondaryButtonStyle}"
                Content="Cancel"
                Click="BackToCatalogue_Click"/>

            <Button
                Grid.Column="2"
                Content="Send request"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{x:Bind ViewModel.SubmitRequestCommand}"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"/>
        </Grid>

    </Grid>
</Page>