<Page
    x:Class="MerchApp.Views.ItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MerchApp.ViewModels"
    Background="#2b2b2b">

    <Grid RowSpacing="12" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0, 0, 0, 12">
            <TextBlock
                Text="Catalogue"
                FontSize="21"
                Style="{StaticResource TitleLargeTextBlockStyle}"/>
            <TextBlock
                Text="Select items you want to request"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Search -->
        <AutoSuggestBox
            Grid.Row="1"
            PlaceholderText="Search items..."
            QueryIcon="Find"
            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"/>

        <!-- Loading -->
        <ProgressRing
            Grid.Row="2"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

        <!-- Error state -->
        <StackPanel
            Grid.Row="2"
            Spacing="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon
                Glyph="&#xE783;"
                FontSize="48"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            <TextBlock
                Text="Could not connect to SharePoint"
                Style="{StaticResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center"/>
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"/>
            <Button
                Content="Try again"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.LoadItemsCommand}"/>
        </StackPanel>

        <!-- Items list -->
        <ListView
            Grid.Row="2"
            x:Name="ItemsList"
            ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolNegationToVisibilityConverter}}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SelectableItem">
                    <Border
                        Padding="12,10"
                        Margin="0,4,12,8"
                        CornerRadius="6"
                        Background="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToSelectedBrushConverter}}">
                        <CheckBox
                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                            <TextBlock
                                Text="{x:Bind Item.Title}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                VerticalAlignment="Center"/>
                        </CheckBox>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Bottom action bar -->
        <Border
            Grid.Row="3"
            Padding="16,12"
            CornerRadius="8"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Style="{StaticResource BodyStrongTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}"/>
                    <Run Text="item(s) selected"/>
                </TextBlock>

                <Button
                    Grid.Column="1"
                    Content="Review &amp; Submit →"
                    Command="{x:Bind ViewModel.GoToCartCommand}"/>
            </Grid>
        </Border>

    </Grid>
</Page>