<Page
    x:Class="MerchApp.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo top-left -->
        <Image
            Grid.Row="0"
            Source="ms-appx:///Assets/LogoDark/icon_256_transparent.png"
            Width="180"
            HorizontalAlignment="Left"
            Margin="32,32,0,16"/>

        <!-- Karta wyśrodkowana -->
        <Border
            Grid.Row="1"
            Width="500"
            Padding="40"
            CornerRadius="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel Spacing="16">

                <TextBlock
                    Text="Welcome to Merch"
                    FontSize="26"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    FontSize="14"
                    Margin="0,0,0,20"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Button
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Height="44"
                    Command="{x:Bind ViewModel.LoginCommand}"
                    FontWeight="SemiBold"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77B;" FontSize="16"/>
                        <TextBlock Text="Sign in with Microsoft 365"/>
                    </StackPanel>
                </Button>

                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    Foreground="#d06d1f"/>

            </StackPanel>
        </Border>

        <!-- SharePoint connection status -->
        <Border
            Grid.Row="2"
            Padding="16,12"
            Margin="16,0,16,16"
            CornerRadius="8"
            Width="500"
            Background="#2b2b2b">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Status dot — green or red -->
                <Ellipse
                    Grid.Column="0"
                    Width="8" Height="8"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    Fill="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToStatusBrushConverter}}"/>

                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToConnectionTextConverter}}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#f1f1f1"/>
                    <TextBlock
                        x:Name="SharePointUrlText"
                        FontSize="11"
                        Foreground="#9a9a9a"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Page>