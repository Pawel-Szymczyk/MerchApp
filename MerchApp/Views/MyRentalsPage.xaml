<Page
    x:Class="MerchApp.Views.MyRentalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MerchApp.Models"
    Background="#2b2b2b">

    <Grid RowSpacing="16" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                Text="My Rentals"
                FontSize="21"
                Style="{StaticResource TitleLargeTextBlockStyle}"/>
            <TextBlock
                Text="Track your rental requests and returns"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Filter -->
        <Border
            Grid.Row="1"
            Width="630"
            Padding="12,8"
            CornerRadius="8"
            BorderBrush="#2effffff"
            BorderThickness="1"
            Background="#2b2b2b">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <RadioButton
                    Content="All"
                    IsChecked="True"
                    Command="{x:Bind ViewModel.FilterByCommand}"
                    CommandParameter="All"/>
                <RadioButton
                    Content="Pending"
                    Command="{x:Bind ViewModel.FilterByCommand}"
                    CommandParameter="Pending"/>
                <RadioButton
                    Content="Active"
                    Command="{x:Bind ViewModel.FilterByCommand}"
                    CommandParameter="Active"/>
                <RadioButton
                    Content="Overdue"
                    Command="{x:Bind ViewModel.FilterByCommand}"
                    CommandParameter="Overdue"/>
                <RadioButton
                    Content="Returned"
                    Command="{x:Bind ViewModel.FilterByCommand}"
                    CommandParameter="Returned"/>
            </StackPanel>
        </Border>

        <!-- Loading -->
        <ProgressRing
            Grid.Row="2"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

        <!-- Empty state -->
        <StackPanel
            Grid.Row="2"
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon
                Glyph="&#xE7BC;"
                FontSize="48"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock
                Text="No rentals yet"
                Style="{StaticResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center"/>
            <TextBlock
                Text="Browse the catalogue and submit your first request"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Requests list -->
        <ListView
            Grid.Row="2"
            Margin="0"
            Padding="0"
            ItemsSource="{x:Bind ViewModel.FilteredRequests, Mode=OneWay}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolNegationToVisibilityConverter}}" 
            >

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:RentalRequest">
                    <Border
                        Padding="16"
                        Margin="0,4,2,8"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">

                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Status + dates -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind RentalFromFormatted}"/>
                                    <Run Text="→"/>
                                    <Run Text="{x:Bind RentalToFormatted}"/>
                                </TextBlock>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind StatusDisplayName}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{x:Bind Status, Converter={StaticResource StatusToColorConverter}}"/>
                            </Grid>

                                              
                            <!-- Expanded details — part of the same frame -->
                            <StackPanel
                                Grid.Row="1"
                                Padding="0,0,0,0"
                                Spacing="12">

                                <Border
                                    Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                                <!-- Items -->
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="ITEMS"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ItemsControl ItemsSource="{x:Bind Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource BodyTextBlockStyle}">
                                                    <Run Text="{Binding ItemName}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Purpose -->
                                <Border
                                    Padding="12,8"
                                    CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    Visibility="{x:Bind Purpose, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock
                                        Text="{x:Bind Purpose}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"/>
                                </Border>

                            </StackPanel>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Page>